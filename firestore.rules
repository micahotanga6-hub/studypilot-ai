rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner() {
      return signedIn() && request.auth.uid == resource.data.uid;
    }
    function createsOwn() {
      return signedIn() && request.auth.uid == request.resource.data.uid;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.plan == "free"
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() < 80;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.plan == resource.data.plan
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() < 80;
      allow delete: if false;
    }

    match /profiles/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() < 80
        && request.resource.data.school is string
        && request.resource.data.school.size() < 120;
      allow delete: if false;
    }

    match /documents/{id} {
      allow read: if isOwner();
      allow delete: if isOwner();
      allow update: if isOwner()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.text == resource.data.text
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["title"]);
      allow create: if false;
    }

    match /summaries/{id} {
      allow read, delete: if isOwner();
      allow update: if isOwner()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.documentId == resource.data.documentId
        && request.resource.data.style == resource.data.style
        && request.resource.data.title is string
        && request.resource.data.title.size() < 200
        && request.resource.data.markdown is string
        && request.resource.data.markdown.size() < 50000;
      allow create: if false;
    }

    match /flashcardDecks/{id} {
      allow read, delete: if isOwner();
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["title"]);
      allow create: if false;
    }

    match /flashcards/{id} {
      allow read, delete: if isOwner();
      allow update: if isOwner()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.deckId == resource.data.deckId
        && request.resource.data.front == resource.data.front
        && request.resource.data.back == resource.data.back
        && request.resource.data.order == resource.data.order;
      allow create: if false;
    }

    match /quizzes/{id} {
      allow read, delete: if isOwner();
      allow create, update: if false;
    }

    match /quizAnswers/{id} {
      allow read, write: if false;
    }

    match /quizAttempts/{id} {
      allow read: if isOwner();
      allow write: if false;
    }

    match /studyPlans/{id} {
      allow read, delete: if isOwner();
      allow create: if createsOwn()
        && request.resource.data.source == "manual"
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() < 160;
      allow update: if isOwner() && request.resource.data.uid == resource.data.uid
        && request.resource.data.source == resource.data.source;
    }

    match /studyTasks/{id} {
      allow read, delete: if isOwner();
      allow create: if createsOwn()
        && request.resource.data.done == false
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() < 200
        && request.resource.data.planId is string
        && request.resource.data.date is string;
      allow update: if isOwner()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.planId == resource.data.planId
        && request.resource.data.date == resource.data.date
        && request.resource.data.kind == resource.data.kind
        && request.resource.data.done is bool
        && request.resource.data.title is string
        && request.resource.data.title.size() < 200;
    }

    match /tutorConversations/{id} {
      allow read, delete: if isOwner();
      allow create, update: if false;
    }

    match /tutorMessages/{id} {
      allow read: if isOwner();
      allow write: if false;
    }

    match /studySessions/{id} {
      allow read: if isOwner();
      allow create: if createsOwn()
        && request.resource.data.kind == "review"
        && request.resource.data.refId is string
        && request.resource.data.refId.size() < 140;
      allow update, delete: if false;
    }

    match /subscriptions/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /paymentRecords/{id} {
      allow read: if isOwner();
      allow write: if false;
    }

    match /usageRecords/{id} {
      allow read: if signedIn() && id.matches('^' + request.auth.uid + '_[0-9]{4}-[0-9]{2}$');
      allow write: if false;
    }

    match /contactMessages/{id} {
      allow read, write: if false;
    }
  }
}

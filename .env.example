# Copy this file to .env.local for local work.
# On Vercel, add the same names in Project Settings → Environment Variables,
# then redeploy. NEXT_PUBLIC_ values are baked in at build time.

# --- Firebase web app config (public, safe to expose to the browser) ---
# Firebase console → Project settings → General → Your apps → Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional public contact address shown on the contact page.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Firebase Admin service account (server only, never NEXT_PUBLIC_) ---
# Firebase console → Project settings → Service accounts → Generate new private key.
# Use either the three fields below, or FIREBASE_SERVICE_ACCOUNT_JSON, not both.
# In Vercel, paste the private key as one line with \n where the line breaks were.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Optional alternative: the whole service-account JSON on one line.
# If this is set, it is used instead of the three FIREBASE_ADMIN_* fields.
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional if the bucket name differs from NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET.
# FIREBASE_STORAGE_BUCKET=

# --- Grok / xAI (server only) ---
# Create a key at https://console.x.ai
XAI_API_KEY=
# Model name your xAI account can call. grok-4.7 is the default if this is empty.
XAI_MODEL=grok-4.7
# Optional. Leave unset to use https://api.x.ai/v1
# XAI_BASE_URL=https://api.x.ai/v1
# Optional reasoning effort for models that support it: low, medium, or high.
# Leave unset for the widest model compatibility.
# XAI_REASONING_EFFORT=low

# --- Billing (nothing is charged until a provider is implemented) ---
# Keep this as none. A future provider id can be added in lib/billing.
BILLING_PROVIDER=none
